<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phoenix for macOS and Linux: the headless helper behind the Electron window. It owns the library, the database,
       the servers, the play queue and VLC's engine (libVLC), and is spoken to over stdin/stdout by the Electron main
       process. It also runs on Windows, which is how it is developed and self-tested. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Phoenix.Backend</RootNamespace>
    <AssemblyName>Phoenix.Backend</AssemblyName>
    <Version>1.0.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\android\Halcyon.Core\Halcyon.Core.csproj" />
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <!-- the speech model that writes lyrics (whisper.cpp): Vulkan for any graphics card on Windows and Linux x64, Metal on
         Apple chips (in the plain runtime), the processor elsewhere. The source is shared with the Windows app. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <Compile Include="..\..\Services\SpeechLyrics.cs" Link="SpeechLyrics.cs" />
    <Compile Include="..\..\Services\Backgrounds.cs" Link="Backgrounds.cs" />
    <!-- libVLC itself: the Windows build for running here; the Intel Mac build carries the NuGet copy; the Apple Silicon
         build gets VideoLAN's arm64 engine from ..\..\vendor (package.py); Linux uses the system's VLC. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.*" Condition="'$(RuntimeIdentifier)' == 'osx-x64'" />
  </ItemGroup>

  <Import Project="..\..\WhisperRuntimes.targets" />

</Project>
