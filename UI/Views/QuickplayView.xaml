<UserControl x:Class="Halcyon.UI.QuickplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Halcyon.UI">
    <UserControl.Resources>
        <DataTemplate x:Key="QuickTile">
            <Button Style="{StaticResource BareBtn}" Padding="6" Click="Tile_Click" MouseRightButtonUp="Tile_RightClick" Width="124">
                <StackPanel>
                    <Grid Width="112" Height="112" Background="{DynamicResource BgAlt}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image ui:Art.Path="{Binding ArtPath}" ui:Art.Size="240" Stretch="UniformToFill"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" FontSize="12"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource FgDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,14,0,0" Focusable="False">
            <Grid x:Name="Sections">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="pins" Style="{StaticResource ZuneHead}"/>
                    <TextBlock x:Name="PinsHint" Foreground="{DynamicResource FgFaint}" TextWrapping="Wrap" Margin="6,16,0,0"
                               Text="Right-click an artist, album or playlist and choose “Pin to quickplay” to keep it here."/>
                    <ItemsControl x:Name="PinsList" ItemTemplate="{StaticResource QuickTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="new" Style="{StaticResource ZuneHead}"/>
                    <ItemsControl x:Name="NewList" ItemTemplate="{StaticResource QuickTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="history" Style="{StaticResource ZuneHead}"/>
                        <Button Style="{StaticResource TextBtn}" Content="&#xE9D2;  listening stats" Click="Stats_Click" Margin="22,26,0,0" VerticalAlignment="Center" ToolTip="Hours, plays and your top artists, albums and songs"/>
                    </StackPanel>
                    <TextBlock x:Name="HistoryHint" Foreground="{DynamicResource FgFaint}" Margin="6,16,0,0" Text="What you play shows up here."/>
                    <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource QuickTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,26,16,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="liked" Style="{StaticResource ZuneHead}"/>
                        <Button x:Name="PlayLikedBtn" Style="{StaticResource TextBtn}" Content="&#xE768;  play all" Click="PlayLiked_Click" Margin="22,26,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="ShuffleLikedBtn" Style="{StaticResource TextBtn}" Content="&#xE8B1;  shuffle" Click="ShuffleLiked_Click" Margin="14,26,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="LikedHint" Foreground="{DynamicResource FgFaint}" Margin="6,16,0,0" Text="Songs you like (the heart next to a song) collect here, newest first."/>
                    <ItemsControl x:Name="LikedList" ItemTemplate="{StaticResource QuickTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="welcome" Style="{StaticResource H2}" FontSize="34" HorizontalAlignment="Center"/>
            <TextBlock Foreground="{DynamicResource FgDim}" TextAlignment="Center" Margin="0,0,0,14"
                       Text="Add your music, video and picture folders, or connect a Jellyfin or Plex server, to get started."/>
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="UseUsualBtn" Style="{StaticResource PillBtn}" Content="USE MY MUSIC, VIDEOS AND PICTURES" Margin="0,0,10,8" Click="UseUsual_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="CHOOSE FOLDERS OR A SERVER" Margin="0,0,0,8" Click="OpenSettings_Click"/>
            </WrapPanel>
            <TextBlock x:Name="UsualText" Foreground="{DynamicResource FgFaint}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
