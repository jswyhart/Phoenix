<UserControl x:Class="Halcyon.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <!-- Laid out like the Zune software's settings: SOFTWARE / PHONE / SERVERS across the top, a list of
         categories down the left, the chosen category's options on the right, and OK at the bottom. -->
    <Grid Margin="28,6,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="PivotSoftware" Style="{StaticResource NavTab}" Content="SOFTWARE" Tag="software" GroupName="settingsPivot" Click="Pivot_Click" FontSize="15" FontFamily="Segoe UI Semibold"/>
            <RadioButton x:Name="PivotPhone" Style="{StaticResource NavTab}" Content="PHONE" Tag="phone" GroupName="settingsPivot" Click="Pivot_Click" FontSize="15" FontFamily="Segoe UI Semibold"/>
            <RadioButton x:Name="PivotServers" Style="{StaticResource NavTab}" Content="SERVERS" Tag="servers" GroupName="settingsPivot" Click="Pivot_Click" FontSize="15" FontFamily="Segoe UI Semibold"/>
        </StackPanel>

        <!-- categories -->
        <ListBox x:Name="CategoryList" Grid.Row="1" Margin="-8,0,24,0" SelectionChanged="Category_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="15" Height="34" Padding="0,7,0,0"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- the chosen category -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="Page_Wheel">
            <Grid MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,18,36">

                <!-- SOFTWARE / Collection -->
                <StackPanel x:Name="PanelCollection">
                    <TextBlock Text="collection" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Phoenix watches these folders, and any servers you connect, for music, videos, pictures and books. Everything is checked for changes each time Phoenix starts. Files stay where they are."/>

                    <TextBlock Style="{StaticResource Label}" Text="MUSIC FOLDERS"/>
                    <ListBox x:Name="MusicFolders" Height="84" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="ADD FOLDER" Tag="music" Click="AddFolder_Click" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PillBtn}" Content="REMOVE" Tag="music" Click="RemoveFolder_Click" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Label}" Text="VIDEO FOLDERS"/>
                    <ListBox x:Name="VideoFolders" Height="64" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="ADD FOLDER" Tag="video" Click="AddFolder_Click" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PillBtn}" Content="REMOVE" Tag="video" Click="RemoveFolder_Click" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Label}" Text="PICTURE FOLDERS"/>
                    <ListBox x:Name="PictureFolders" Height="64" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="ADD FOLDER" Tag="picture" Click="AddFolder_Click" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PillBtn}" Content="REMOVE" Tag="picture" Click="RemoveFolder_Click" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Label}" Text="BOOK FOLDERS (AUDIOBOOKS, EBOOKS AND COMICS)"/>
                    <ListBox x:Name="BookFolders" Height="64" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="ADD FOLDER" Tag="book" Click="AddFolder_Click" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PillBtn}" Content="REMOVE" Tag="book" Click="RemoveFolder_Click" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="RescanBtn" Style="{StaticResource PillBtn}" Content="RESCAN COLLECTION NOW" Click="Rescan_Click" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PillBtn}" Content="FIND DUPLICATES AND MISSING FILES" Click="Care_Click" ToolTip="The same song stored twice, and songs whose files have gone" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource Status}"/>
                </StackPanel>

                <!-- SOFTWARE / Rip -->
                <StackPanel x:Name="PanelRip" Visibility="Collapsed">
                    <TextBlock Text="rip" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Ripping copies the songs from an audio CD into your collection. Put a CD in the drive, click the disc icon in the lower left, then START RIP. Songs are saved in your first music folder."/>
                    <TextBlock Style="{StaticResource Label}" Text="AUDIO FORMAT AND QUALITY"/>
                    <StackPanel x:Name="RipFormats" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,14,0,0" Text="MP3 plays everywhere; a higher bitrate sounds better and takes more room. AAC is a little smaller at the same quality. FLAC is an exact copy of the disc at about half the size of WAV, and plays in most players. WAV is an exact copy too, and much larger."/>
                </StackPanel>

                <!-- SOFTWARE / Burn -->
                <StackPanel x:Name="PanelBurn" Visibility="Collapsed">
                    <TextBlock Text="burn" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="To burn a disc, drag songs, albums or playlists from your collection to the disc icon in the lower left. That builds your burn list. Then click the disc icon, put a blank CD in the drive and choose START BURN."/>
                    <TextBlock Style="{StaticResource Label}" Text="DISC FORMAT"/>
                    <RadioButton x:Name="BurnAudioRadio" Content="Audio CD (plays in any CD player; holds about 80 minutes)" GroupName="burnKind" Tag="0" Click="BurnKind_Click" Foreground="{DynamicResource Fg}" Margin="0,4,0,0"/>
                    <RadioButton x:Name="BurnMp3Radio" Content="MP3 CD (songs as MP3 files; hours of music for MP3 CD players, car stereos and computers)" GroupName="burnKind" Tag="1" Click="BurnKind_Click" Foreground="{DynamicResource Fg}" Margin="0,8,0,0"/>
                    <RadioButton x:Name="BurnDataRadio" Content="Data disc (the files as they are, on a CD, DVD or Blu-ray; for computers and players that read them)" GroupName="burnKind" Tag="2" Click="BurnKind_Click" Foreground="{DynamicResource Fg}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="MP3 quality" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="110"/>
                        <ComboBox x:Name="BurnKbpsBox" Width="150" SelectionChanged="BurnKbps_Changed" ToolTip="Songs that aren't MP3s already are converted at this quality for an MP3 CD (and songs from a server, for a data disc)"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Songs that are MP3s already are copied as they are. On an MP3 or data disc the songs are numbered in burn list order and a playlist is added, so players play them in that order. A CD holds about 700 MB: around 6 hours of MP3s at 256 kbps, or 10 at 128 kbps."/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="VIEW BURN LIST" Click="ViewBurnList_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- SOFTWARE / Metadata -->
                <StackPanel x:Name="PanelMetadata" Visibility="Collapsed">
                    <TextBlock Text="metadata" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Album details, track names and cover art can come from several places. Switch on the ones you want and give each a weight: when Phoenix fills in missing info it asks the highest weight first and moves down the list for whatever is still missing. Right-click an album to tie it to one source, or to look it up yourself. Every source except the folder pictures is sent the artist and album names."/>
                    <TextBlock Style="{StaticResource Label}" Text="SOURCES"/>
                    <StackPanel x:Name="SourcesPanel" Margin="0,6,0,0"/>
                    <TextBlock x:Name="SourceOrder" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <CheckBox x:Name="WriteTags" Content="Also write changed info and cover art into my music files" Margin="0,10,0,4" Click="WriteTags_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AutoMatchBtn" Style="{StaticResource PillBtn}" Content="fill in albums missing info" Click="AutoMatch_Click"
                                ToolTip="Asks your sources, by weight, about every album that has no cover, year or genre"/>
                    </StackPanel>
                    <TextBlock x:Name="DiscogsStatus" Style="{StaticResource Status}"/>
                    <TextBlock Style="{StaticResource Label}" Text="IDENTIFY SONGS BY SOUND (ACOUSTID)" Margin="0,22,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="For songs with missing or wrong names: Phoenix listens to the file and looks it up. This needs a free application key from acoustid.org and the fpcalc program from acoustid.org/chromaprint, which you download yourself. Then right-click a song and choose “Identify by sound…”."/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="key" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="AcoustKey" Grid.Column="1" Width="260" HorizontalAlignment="Left" LostFocus="AcoustSave"/>
                        <TextBlock Grid.Row="1" Text="fpcalc.exe" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="FpcalcBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" LostFocus="AcoustSave"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PillBtn}" Content="BROWSE" Margin="10,8,0,0" Click="FpcalcBrowse_Click"/>
                    </Grid>
                </StackPanel>

                <!-- SOFTWARE / Display -->
                <StackPanel x:Name="PanelDisplay" Visibility="Collapsed">
                    <TextBlock Text="display" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Label}" Text="THEME"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox x:Name="ThemeBox" Width="260" SelectionChanged="ThemeBox_Changed"/>
                        <Button Style="{StaticResource PillBtn}" Content="CUSTOMISE" Margin="10,0,0,0" Click="ThemeDesign_Click" ToolTip="Change this theme's colours and fonts, or make a new theme from it"/>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource TextBtn}" Content="import" Margin="0,0,16,0" Click="ThemeImport_Click" ToolTip="Add a theme file someone gave you"/>
                        <Button x:Name="ThemeExportBtn" Style="{StaticResource TextBtn}" Content="export" Margin="0,0,16,0" Click="ThemeExport_Click" ToolTip="Save this theme as a file to share"/>
                        <Button x:Name="ThemeDeleteBtn" Style="{StaticResource TextBtn}" Content="delete" Margin="0,0,16,0" Click="ThemeDelete_Click" ToolTip="Remove this theme (Phoenix goes back to its base, light or dark)"/>
                        <Button Style="{StaticResource TextBtn}" Content="open themes folder" Click="ThemeFolder_Click" ToolTip="Your themes are small text files you can also edit by hand: Phoenix shows a change as soon as you save it" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <Grid x:Name="SystemThemes" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="when Windows is light" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LightThemeBox" Grid.Column="1" Width="260" SelectionChanged="SideTheme_Changed" ToolTip="The theme Phoenix shows while Windows is set to light for apps"/>
                        <TextBlock Grid.Row="1" Text="when Windows is dark" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="DarkThemeBox" Grid.Row="1" Grid.Column="1" Width="260" Margin="0,8,0,0" SelectionChanged="SideTheme_Changed" ToolTip="The theme Phoenix shows while Windows is set to dark for apps"/>
                    </Grid>
                    <TextBlock x:Name="ThemeNote" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="BACKGROUND PICTURE" Margin="0,22,0,3"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="CHOOSE PICTURE" Click="BackPick_Click" ToolTip="A picture of your own behind Phoenix's window" Margin="0,0,10,8"/>
                        <Button x:Name="BackRemoveBtn" Style="{StaticResource TextBtn}" Content="remove" Click="BackRemove_Click" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="BackStrengthRow" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="how much it shows" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="130"/>
                        <Slider x:Name="BackStrength" Width="220" Minimum="5" Maximum="90" SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="BackStrength_Changed"/>
                        <TextBlock x:Name="BackStrengthText" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="BackNote" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="COLLECTION TABS" Margin="0,22,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="Choose which tabs your collection shows. A tab that is off is only hidden: nothing in it is removed, and it comes back as it was."/>
                    <WrapPanel x:Name="TabChecks"/>
                    <TextBlock Style="{StaticResource Label}" Text="WHEN THE WINDOW IS CLOSED" Margin="0,22,0,3"/>
                    <CheckBox x:Name="RunInTrayBox" Content="Keep Phoenix running in the notification area" Margin="0,4,0,0" Click="RunInTray_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="On: closing the window hides it and the music carries on. Phoenix's icon by the clock brings it back; right-click the icon to play, pause, skip or quit. Off: closing the window quits Phoenix."/>
                    <TextBlock Style="{StaticResource Label}" Text="QUICKPLAY" Margin="0,22,0,3"/>
                    <CheckBox x:Name="QuickplayPlaysBox" Content="Clicking an album in quickplay plays it straight away" Margin="0,4,0,0" Click="QuickplayPlays_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="Off: a click opens the album in your collection; right-click a tile to play it."/>
                    <TextBlock Style="{StaticResource Label}" Text="ARTIST PHOTOS" Margin="0,22,0,3"/>
                    <CheckBox x:Name="BackdropsBox" Content="Show photos of the artist behind now playing" Margin="0,4,0,0" Click="Backdrops_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="The artist's name is sent to find them: to fanart.tv and TheAudioDB if you entered their keys under metadata (wide photos), otherwise to Deezer (a portrait). Photos are kept in Phoenix's data folder."/>
                    <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                        <TextBlock x:Name="BackdropUsage" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TextBtn}" Content="remove kept photos" Margin="16,0,0,0" Click="BackdropsClear_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="NOW PLAYING VISUALIZER" Margin="0,22,0,3"/>
                    <ComboBox x:Name="VizStyle" Width="260" HorizontalAlignment="Left" SelectionChanged="Viz_Changed"/>
                    <TextBlock Style="{StaticResource Label}" Text="VISUALIZER COLOURS"/>
                    <ComboBox x:Name="VizColour" Width="260" HorizontalAlignment="Left" SelectionChanged="Viz_Changed"/>
                    <TextBlock Style="{StaticResource Label}" Text="VISUALIZER SENSITIVITY"/>
                    <ComboBox x:Name="VizSensitivity" Width="260" HorizontalAlignment="Left" SelectionChanged="Viz_Changed"/>
                    <CheckBox x:Name="NowPanelBox" Content="Put a panel behind the song list and lyrics, so they stay readable over the visualizer" Margin="0,14,0,0" Click="NowPanel_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelPlayback" Visibility="Collapsed">
                    <TextBlock Text="playback" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Music plays through a built-in audio engine, so one song runs into the next with no gap, songs can blend into each other, and the equalizer can shape the sound. Videos, podcasts and audiobooks are not affected."/>
                    <CheckBox x:Name="EngineOn" Content="Use the built-in audio engine for music" Margin="0,8,0,4" Click="Engine_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="CROSSFADE"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="CrossfadeSlider" Width="260" Minimum="0" Maximum="12" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Crossfade_Changed"/>
                        <TextBlock x:Name="CrossfadeText" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="VOLUME LEVELLING" Margin="0,22,0,3"/>
                    <CheckBox x:Name="LevelOn" Content="Play every song at about the same loudness" Margin="0,4,0,0" Click="Level_Click"/>
                    <CheckBox x:Name="LevelAlbum" Content="Level whole albums (an album's quiet and loud songs stay as they are to each other)" Margin="24,8,0,0" Click="Level_Click"/>
                    <CheckBox x:Name="LevelMeasureBox" Content="Measure songs that carry no ReplayGain tags" Margin="24,8,0,0" Click="Level_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,8,0,0" Text="Uses the ReplayGain tags in your files where they have them. Other songs are measured the first time they play (a second or two each, in the background) and the result is kept in Phoenix's library; your files are not changed."/>
                    <TextBlock Style="{StaticResource Label}" Text="EQUALIZER" Margin="0,22,0,3"/>
                    <CheckBox x:Name="EqOn" Content="Use the equalizer" Margin="0,4,0,8" Click="Eq_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="EqPreset" Width="200" HorizontalAlignment="Left" SelectionChanged="EqPreset_Changed"/>
                        <Button x:Name="EqResetBtn" Style="{StaticResource PillBtn}" Content="RESET" Margin="10,0,0,0" Click="EqReset_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="EqBands" Orientation="Horizontal" Margin="-6,14,0,0" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Label}" Text="AUTO EQUALIZER" Margin="0,22,0,3"/>
                    <CheckBox x:Name="AutoEqBox" Content="Adjust the sound of each song by itself" Margin="0,4,0,0" Click="AutoEq_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="Each song is measured once (how much of its sound falls in each band) and the equalizer is set for it as it plays, on top of your own equalizer when that is on. Songs are measured the first time they play, or all at once below."/>
                    <StackPanel Orientation="Horizontal" Margin="24,10,0,0">
                        <TextBlock Text="sound" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="80"/>
                        <ComboBox x:Name="AutoEqProfileBox" Width="440" SelectionChanged="AutoEqProfile_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                        <TextBlock Text="keep it" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="80"/>
                        <ComboBox x:Name="AutoEqStoreBox" Width="440" SelectionChanged="AutoEqStore_Changed"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoEqAiBox" Content="Recognise each song's style with AI, for a target that suits it" Margin="24,12,0,0" Click="AutoEqAi_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="48,2,0,0" Text="Google's YAMNet sound-recognition model listens to three short stretches of each song and tells electronic, hip hop, rock, pop, acoustic, jazz and classical apart, and singing or speech, so each is evened out towards a balance that suits it. It runs on the graphics card (any AMD, Intel or NVIDIA graphics), on this computer only. The model (15 MB) is downloaded once; songs measured before are listened to again."/>
                    <StackPanel Orientation="Horizontal" Margin="48,6,0,0">
                        <Button x:Name="AutoEqAiDownloadBtn" Style="{StaticResource PillBtn}" Content="DOWNLOAD THE MODEL" Click="AutoEqAiDownload_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="24,12,0,0">
                        <Button x:Name="AutoEqScanBtn" Style="{StaticResource PillBtn}" Content="MEASURE ALL SONGS NOW" Click="AutoEqScan_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AutoEqStatus" Style="{StaticResource Status}" Margin="24,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Label}" Text="HEADPHONES AND SPEAKERS" Margin="0,22,0,3"/>
                    <CheckBox x:Name="HeadphoneBox" Content="Correct for my headphones or speakers" Margin="0,4,0,0" Click="Headphone_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="From the AutoEq project: measurements of thousands of headphones, earbuds and speakers, each with a correction towards a neutral sound. Find yours by name; its correction goes on top of everything else. The list and the profile come from AutoEq's page on GitHub."/>
                    <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                        <TextBox x:Name="HeadphoneSearch" Width="320" KeyDown="HeadphoneSearch_KeyDown" ToolTip="For example: sony wf-1000xm5, hd 600, airpods pro"/>
                        <Button Style="{StaticResource PillBtn}" Content="FIND" Click="HeadphoneFind_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="HeadphoneList" Margin="24,6,0,0" MaxHeight="200" Width="520" HorizontalAlignment="Left" Visibility="Collapsed" SelectionChanged="HeadphoneList_Changed"/>
                    <TextBlock x:Name="HeadphoneStatus" Style="{StaticResource Status}" Margin="24,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="PanelPodcasts" Visibility="Collapsed">
                    <TextBlock Text="podcasts" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Subscribe to a podcast from collection → podcasts with its RSS feed address. New episodes are marked in the series list until you play them."/>
                    <CheckBox x:Name="PodcastAuto" Content="Look for new episodes when the app starts and every hour" Margin="0,8,0,4" Click="PodcastAuto_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="KEEP DOWNLOADED"/>
                    <ComboBox x:Name="PodcastKeep" Width="380" HorizontalAlignment="Left" SelectionChanged="PodcastKeep_Changed"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="This applies to every series; right-click a series on the podcasts page to give it its own choice, to download all its unplayed episodes, or to remove its downloads. An episode you download yourself is kept until you play it or remove it."/>
                    <CheckBox x:Name="PodcastRemovePlayed" Content="Remove a download once its episode has been played" Margin="0,10,0,4" Click="PodcastRemovePlayed_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="DOWNLOAD FOLDER"/>
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource PillBtn}" Content="BROWSE" Margin="10,0,0,0" Click="PodcastFolderBrowse_Click"/>
                            <Button Style="{StaticResource PillBtn}" Content="DEFAULT" Margin="6,0,0,0" Click="PodcastFolderDefault_Click" ToolTip="Back to the folder inside Phoenix's own data"/>
                        </StackPanel>
                        <TextBox x:Name="PodcastFolderBox" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Each series gets its own folder there, with episodes named by date and title, so other players and devices can use them too. Changing the folder affects new downloads; episodes already downloaded stay where they are."/>
                    <TextBlock x:Name="PodcastUsage" Foreground="{DynamicResource FgDim}" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="OPEN FOLDER" Margin="0,0,10,8" Click="PodcastFolderOpen_Click"/>
                        <Button Style="{StaticResource PillBtn}" Content="REMOVE ALL DOWNLOADS" Margin="0,0,10,8" Click="PodcastRemoveAll_Click"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="PanelTranslation" Visibility="Collapsed">
                    <TextBlock Text="translation and lyrics" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Phoenix can show a translation beside song, artist and album names that are written in another language, in a quieter colour after the original. Each name is translated once and remembered. The names are sent to the service you choose."/>
                    <CheckBox x:Name="TranslateOnBox" Content="Show translated names beside the originals" Margin="0,8,0,4" Click="TranslationChanged"/>
                    <TextBlock Style="{StaticResource Label}" Text="TRANSLATE INTO"/>
                    <ComboBox x:Name="TranslateLang" Width="260" HorizontalAlignment="Left" SelectionChanged="TranslationSelection"/>
                    <TextBlock Style="{StaticResource Label}" Text="SERVICE"/>
                    <ComboBox x:Name="TranslateService" Width="420" HorizontalAlignment="Left" SelectionChanged="TranslationSelection"/>
                    <StackPanel x:Name="TranslateKeyRow" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="key" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                        <PasswordBox x:Name="TranslateKey" Width="300" LostFocus="TranslationChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="LibreRow" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="server" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                        <TextBox x:Name="LibreUrlBox" Width="300" LostFocus="TranslationChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="TranslateHelp" Foreground="{DynamicResource FgFaint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="LocalPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Note}" Text="Translating on this PC sends nothing anywhere. It uses the translation engine from Firefox with language packs you download once (about 35 to 55 MB each, from Mozilla). It can tell Japanese, Korean, Chinese, Russian, Ukrainian, Arabic, Hebrew, Greek, Thai and Hindi names by their script; names in Latin letters are left as they are."/>
                        <TextBlock Style="{StaticResource Label}" Text="LANGUAGE PACKS"/>
                        <StackPanel x:Name="PackList" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PackStatus" Style="{StaticResource Status}"/>
                        <TextBlock Style="{StaticResource Label}" Text="LANGUAGE PACK FOLDER"/>
                        <DockPanel Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource PillBtn}" Content="MOVE" Margin="10,0,0,0" Click="PackFolderMove_Click"/>
                                <Button Style="{StaticResource PillBtn}" Content="DEFAULT" Margin="6,0,0,0" Click="PackFolderDefault_Click" ToolTip="Back inside Phoenix's data folder"/>
                            </StackPanel>
                            <TextBox x:Name="PackFolderBox" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock x:Name="PackUsage" Foreground="{DynamicResource FgDim}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="TranslateLatinBox" Content="Also translate names written in Latin letters" Margin="0,10,0,0" Click="TranslationChanged"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="Off: only names in other scripts (Japanese, Korean, Russian, Arabic…) are sent. On: every name is sent, which uses a free service's daily limit quickly."/>
                    <TextBlock x:Name="TranslateStatus" Style="{StaticResource Status}"/>
                    <TextBlock Style="{StaticResource Label}" Text="LYRICS" Margin="0,22,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="In now playing, the lyrics tab can find lyrics on LRCLIB (a free, open lyrics database, often with timing), take them from a .lrc or .txt file, or from the clipboard. Lyrics you import are kept in Phoenix's data folder, not in your music folders."/>
                    <CheckBox x:Name="LyricsAutoBox" Content="Look lyrics up on LRCLIB by itself when a song has none" Margin="0,8,0,4" Click="TranslationChanged"/>
                    <TextBlock Style="{StaticResource Label}" Text="WRITING LYRICS WITH A SPEECH MODEL" Margin="0,18,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="A speech model (whisper.cpp) can listen to a song and write down what is sung, with timing, on this computer: nothing is sent anywhere. It works best on clear vocals and can mishear words, especially under loud music. It runs on the graphics card when it can (AMD, Intel or NVIDIA, built in or separate) and on the processor otherwise. Models are downloaded once from whisper.cpp's page on Hugging Face."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="model" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="110"/>
                        <ComboBox x:Name="SpeechModelBox" Width="330" SelectionChanged="SpeechModel_Changed"/>
                        <Button x:Name="SpeechDownloadBtn" Style="{StaticResource PillBtn}" Content="DOWNLOAD" Click="SpeechDownload_Click" Margin="10,0,0,0"/>
                        <Button x:Name="SpeechDeleteBtn" Style="{StaticResource TextBtn}" Content="delete" Click="SpeechDelete_Click" Margin="4,0,0,0" ToolTip="Remove the downloaded model to free its space"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="runs on" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Width="110"/>
                        <ComboBox x:Name="SpeechGpuBox" Width="330" SelectionChanged="SpeechGpu_Changed" ToolTip="Automatic uses the separate graphics card if there is one, otherwise the built-in graphics"/>
                    </StackPanel>
                    <CheckBox x:Name="LyricsListenBox" Content="Write lyrics with the speech model as songs play, for songs that have no lyrics" Margin="0,10,0,0" Click="LyricsListen_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="What the model writes is shown on a tab of its own in now playing, “generated”, next to lyrics. The tab is there while a model is downloaded and chosen."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SpeechAllBtn" Style="{StaticResource PillBtn}" Content="WRITE LYRICS FOR SONGS THAT HAVE NONE" Click="SpeechAll_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SpeechStatus" Style="{StaticResource Status}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="PanelStorage" Visibility="Collapsed">
                    <TextBlock Text="storage" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="This folder holds Phoenix's library database, settings, album covers, picture and artwork caches, imported lyrics, podcast downloads (unless you gave them their own folder) and the Spotify sign-in. Your music, videos, pictures and books stay where they are."/>
                    <TextBlock Style="{StaticResource Label}" Text="DATA FOLDER"/>
                    <TextBox x:Name="StorageBox" IsReadOnly="True"/>
                    <TextBlock x:Name="StorageUsage" Foreground="{DynamicResource FgDim}" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="StorageChangeBtn" Style="{StaticResource PillBtn}" Content="MOVE TO ANOTHER FOLDER" Margin="0,0,10,8" Click="StorageChange_Click"/>
                        <Button x:Name="StorageDefaultBtn" Style="{StaticResource PillBtn}" Content="BACK TO THE STANDARD FOLDER" Margin="0,0,10,8" Click="StorageDefault_Click"/>
                        <Button Style="{StaticResource PillBtn}" Content="OPEN" Margin="0,0,10,8" Click="StorageOpen_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Text="Moving copies everything to the new folder, restarts Phoenix from there and then removes the old copies. If the folder you pick already holds a Phoenix library, that library is used instead and nothing is copied."/>
                    <TextBlock x:Name="StorageStatus" Style="{StaticResource Status}"/>
                    <TextBlock Style="{StaticResource Label}" Text="BACKUP AND RESTORE" Margin="0,24,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="A backup is one file holding your playlists, likes, play counts and the play log, bookmarks and reading progress, podcasts, pins, tags, imported lyrics and your settings. Your music, videos, pictures and books themselves are not in it. Sign-ins and keys in a backup only work again for the same Windows user."/>
                    <CheckBox x:Name="BackupCovers" Content="Include album covers (a much larger file)" Margin="0,2,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource PillBtn}" Content="BACK UP NOW…" Margin="0,0,10,8" Click="Backup_Click"/>
                        <Button Style="{StaticResource PillBtn}" Content="RESTORE FROM A BACKUP…" Margin="0,0,10,8" Click="Restore_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackupStatus" Style="{StaticResource Status}"/>
                </StackPanel>

                <StackPanel x:Name="PanelListening" Visibility="Collapsed">
                    <TextBlock Text="listening" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Phoenix keeps a log of what you listen to, in its own library, for the stats page (quickplay → listening stats). It can also send your listens to ListenBrainz or Last.fm (“scrobbling”). Nothing is sent unless you switch a service on here."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PillBtn}" Content="SHOW MY STATS" Margin="0" Click="ShowStats_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="INTERNET RADIO" Margin="0,22,0,3"/>
                    <CheckBox x:Name="RadioOn" Content="Show radio in the collection" Margin="0,4,0,0" Click="RadioOn_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="Off: the radio tab and any stations pinned to quickplay are hidden. Your saved stations are kept for when you switch it back on."/>
                    <TextBlock Style="{StaticResource Label}" Text="LISTENBRAINZ" Margin="0,22,0,3"/>
                    <CheckBox x:Name="LbOn" Content="Send my listens to ListenBrainz" Margin="0,4,0,0" Click="Scrobble_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Needs your user token, from listenbrainz.org → settings. It is free and needs no application key."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="token" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                        <PasswordBox x:Name="LbToken" Width="300" LostFocus="ScrobbleKeys_Lost"/>
                        <Button Style="{StaticResource PillBtn}" Content="CHECK" Margin="10,0,0,0" Click="LbCheck_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LbStatus" Style="{StaticResource Status}"/>
                    <TextBlock Style="{StaticResource Label}" Text="LAST.FM" Margin="0,22,0,3"/>
                    <CheckBox x:Name="LfmOn" Content="Send my listens to Last.fm" Margin="0,4,0,0" Click="Scrobble_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Needs an API key and its shared secret, from last.fm/api/account/create (free). The key is the same one the Last.fm metadata source uses. CONNECT then opens Last.fm in your browser, where you allow Phoenix: you sign in there, not here."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="key" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                        <PasswordBox x:Name="LfmKey" Width="300" LostFocus="ScrobbleKeys_Lost"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="secret" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                        <PasswordBox x:Name="LfmSecret" Width="300" LostFocus="ScrobbleKeys_Lost"/>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="LfmConnectBtn" Style="{StaticResource PillBtn}" Content="CONNECT…" Margin="0,0,10,8" Click="LfmConnect_Click"/>
                        <Button x:Name="LfmSignOutBtn" Style="{StaticResource PillBtn}" Content="DISCONNECT" Margin="0,0,10,8" Click="LfmSignOut_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="LfmStatus" Style="{StaticResource Status}"/>
                    <TextBlock x:Name="ScrobbleResult" Foreground="{DynamicResource FgDim}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Text="updates" Style="{StaticResource Head}"/>
                    <TextBlock x:Name="AboutVersion" FontSize="15"/>
                    <TextBlock Style="{StaticResource Label}" Text="NEW VERSIONS" Margin="0,22,0,3"/>
                    <CheckBox x:Name="UpdatesOn" Content="Look for a newer Phoenix once a day" Margin="0,4,0,0" Click="UpdatesOn_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="Asks GitHub for Phoenix's public list of releases. Nothing about you or your library is sent."/>
                    <CheckBox x:Name="AutoUpdateOn" Content="Update by itself" Margin="0,4,0,0" Click="UpdatesOn_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="On: a new version is downloaded when it is found and installed when you close Phoenix, without asking; the next start is the new version. Off: Phoenix only tells you, and you choose when to install."/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="UpdateCheckBtn" Style="{StaticResource PillBtn}" Content="CHECK NOW" Margin="0,0,10,8" Click="UpdateCheck_Click"/>
                        <Button x:Name="UpdateInstallBtn" Style="{StaticResource PillBtn}" Content="DOWNLOAD AND INSTALL" Margin="0,0,10,8" Visibility="Collapsed" Click="UpdateInstall_Click"/>
                        <Button x:Name="UpdatePageBtn" Style="{StaticResource PillBtn}" Content="OPEN THE RELEASE PAGE" Margin="0,0,10,8" Visibility="Collapsed" Click="UpdatePage_Click"/>
                        <Button x:Name="UpdateSkipBtn" Style="{StaticResource PillBtn}" Content="SKIP THIS VERSION" Margin="0,0,10,8" Visibility="Collapsed" Click="UpdateSkip_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Status}"/>
                    <TextBlock x:Name="UpdateNotes" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="GOING BACK" Margin="0,22,0,3"/>
                    <CheckBox x:Name="KeepPreviousOn" Content="Keep the version before an update, so the update can be undone" Margin="0,4,0,0" Click="UpdatesOn_Click"/>
                    <TextBlock Style="{StaticResource Note}" Margin="24,2,0,0" Text="On: before an update, the installer of the version you have is kept in Phoenix's data folder (about 50 MB; only one is kept). Off: nothing is kept, and going back downloads the earlier version from GitHub when you ask. Your library and settings are not changed by going back."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RevertBtn" Style="{StaticResource PillBtn}" Content="GO BACK ONE VERSION" Margin="0" Click="Revert_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RevertStatus" Style="{StaticResource Status}"/>
                </StackPanel>

                <StackPanel x:Name="PanelWeb" Visibility="Collapsed">
                    <TextBlock Text="streaming services" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Phoenix can show a streaming service's own web player in its window. Choose where each one goes with “show in”: a collection tab of its own, under any part of your collection (music services start on a tab of their own, video services under videos), or in a tab you made yourself (below). You sign in on the service's own page; Phoenix does not see your password. Their music and videos stay in their players: they are not added to your library, playlists or search, and the equalizer and visualizer do not apply. While a service is playing, the player bar's controls work it, showing only the controls that service supports."/>
                    <TextBlock Style="{StaticResource Label}" Text="MUSIC"/>
                    <StackPanel x:Name="WebMusicPanel" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="VIDEO" Margin="0,18,0,3"/>
                    <StackPanel x:Name="WebVideoPanel" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="YOUR OWN" Margin="0,18,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="Any web address, or an HTML file on this PC (for example C:\apps\player\index.html)."/>
                    <StackPanel x:Name="WebCustomPanel" Margin="0,6,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WebNameBox" ToolTip="A name for the tab"/>
                        <TextBox x:Name="WebUrlBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Web address or path to an HTML file"/>
                        <ComboBox x:Name="WebKindBox" Grid.Column="2" Width="90" Margin="8,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="music"/>
                            <ComboBoxItem Content="video"/>
                        </ComboBox>
                        <Button Grid.Column="3" Style="{StaticResource PillBtn}" Content="ADD" Margin="8,0,0,0" Click="WebAdd_Click"/>
                    </Grid>
                    <TextBlock x:Name="WebStatus" Style="{StaticResource Status}"/>
                    <TextBlock Style="{StaticResource Label}" Text="TABS OF YOUR OWN" Margin="0,22,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="A tab of your own sits with the others in your collection and holds the streaming services you put in it (choose it under “show in” above)."/>
                    <StackPanel x:Name="CustomTabRows"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="NewTabName" Width="220" ToolTip="A name for the new tab"/>
                        <Button Style="{StaticResource PillBtn}" Content="ADD TAB" Margin="8,0,0,0" Click="AddTab_Click"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Pages are shown with the browser engine built into Windows (Microsoft Edge WebView2), which can play protected streams. Firefox cannot be placed inside another program's window, so it could not be used here. Some services limit picture quality in browsers, or may refuse an embedded browser."/>
                </StackPanel>

                <!-- PHONE / Sync options -->
                <StackPanel x:Name="PanelPhone" Visibility="Collapsed">
                    <TextBlock Text="sync options" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="The companion app on your Android phone copies music, likes and playlists from this PC while both are on the same Wi-Fi network. On the phone, open settings → sync with PC and enter the code below."/>
                    <CheckBox x:Name="SyncEnabled" Content="Let my phone sync with and control this PC" Margin="0,8,0,4" Click="SyncEnabled_Click"/>
                    <TextBlock x:Name="SyncStatus" Style="{StaticResource Status}" TextWrapping="Wrap"/>
                    <Button x:Name="SyncNewCodeBtn" Style="{StaticResource PillBtn}" Content="NEW CODE" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SyncNewCode_Click"
                            ToolTip="Replaces the pairing code; phones paired with the old code must enter the new one"/>
                    <TextBlock Style="{StaticResource Label}" Text="REMOTE CONTROL" Margin="0,24,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="While sync is on, the phone can also work this PC: play, pause, skip, the volume and the queue. In the phone app choose “remote”; or open the address below in any browser on your network and enter the pairing code."/>
                    <TextBlock x:Name="RemoteAddress" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Label}" Text="ITEMS I CHOOSE" Margin="0,24,0,3"/>
                    <TextBlock Style="{StaticResource Note}" Text="Drag songs, albums, artists or playlists from your collection to the phone icon in the lower left. They are added to your phone sync list and copied the next time the phone syncs."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PillBtn}" Content="VIEW PHONE SYNC LIST" Click="ViewPhone_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- SERVERS / Jellyfin -->
                <StackPanel x:Name="PanelJellyfin" Visibility="Collapsed">
                    <TextBlock Text="jellyfin" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Add a Jellyfin server to your collection like a folder: its music, movies, shows, collections, photos and books appear alongside your own and stream from the server."/>
                    <TextBlock Style="{StaticResource Label}" Text="SERVER ADDRESS"/>
                    <TextBox x:Name="JfUrl"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="USER NAME"/>
                            <TextBox x:Name="JfUser"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="PASSWORD"/>
                            <PasswordBox x:Name="JfPassword"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="JfConnectBtn" Style="{StaticResource PillBtn}" Content="CONNECT &amp; SYNC" Click="JfConnect_Click" Margin="0,0,10,8"/>
                        <Button x:Name="JfSyncBtn" Style="{StaticResource PillBtn}" Content="SYNC NOW" Click="JfSync_Click" Margin="0,0,10,8"/>
                        <Button x:Name="JfDisconnectBtn" Style="{StaticResource PillBtn}" Content="DISCONNECT" Click="JfDisconnect_Click" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="JfStatus" Style="{StaticResource Status}"/>
                </StackPanel>

                <!-- SERVERS / Plex -->
                <StackPanel x:Name="PanelPlex" Visibility="Collapsed">
                    <TextBlock Text="plex" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Note}" Text="Add a Plex Media Server to your collection like a folder. Sign in with Plex to find your servers, or enter an address and token yourself."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlexSignInBtn" Style="{StaticResource PillBtn}" Content="SIGN IN WITH PLEX…" Click="PlexSignIn_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="PlexServers" Margin="0,8,0,0" Visibility="Collapsed" SelectionChanged="PlexServers_SelectionChanged"/>
                    <TextBlock Style="{StaticResource Label}" Text="SERVER ADDRESS"/>
                    <TextBox x:Name="PlexUrl"/>
                    <TextBlock Style="{StaticResource Label}" Text="TOKEN"/>
                    <PasswordBox x:Name="PlexToken"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="PlexConnectBtn" Style="{StaticResource PillBtn}" Content="CONNECT &amp; SYNC" Click="PlexConnect_Click" Margin="0,0,10,8"/>
                        <Button x:Name="PlexDisconnectBtn" Style="{StaticResource PillBtn}" Content="DISCONNECT" Click="PlexDisconnect_Click" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="PlexStatus" Style="{StaticResource Status}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PillBtn}" Content="OK" MinWidth="96" Margin="0" Click="Ok_Click" ToolTip="Changes are saved as you make them"/>
        </StackPanel>
    </Grid>
</UserControl>
