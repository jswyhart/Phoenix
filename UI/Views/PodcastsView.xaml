<UserControl x:Class="Halcyon.UI.PodcastsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Halcyon.UI">
    <Grid Margin="20,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-4,4,6">
                    <Button Style="{StaticResource TextBtn}" Content="&#xE710;  add" Click="Add_Click" Margin="0,0,12,0" ToolTip="Subscribe to a podcast by feed address"/>
                    <Button x:Name="RefreshBtn" Style="{StaticResource TextBtn}" Content="&#xE72C;  refresh" Click="Refresh_Click"/>
                </StackPanel>
                <TextBlock x:Name="SeriesCap" Style="{StaticResource Cap}" Text="SERIES"/>
            </DockPanel>
            <ListBox x:Name="SeriesList" SelectionChanged="Series_SelectionChanged" MouseRightButtonUp="Series_RightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Height="64">
                            <Grid DockPanel.Dock="Left" Width="52" Height="52" Background="{DynamicResource BgAlt}" Margin="0,0,12,0">
                                <Image ui:Art.Path="{Binding ArtUrl}" ui:Art.Size="120" Stretch="UniformToFill"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding NewText}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,6,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Author}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock x:Name="PodTitle" DockPanel.Dock="Top" Style="{StaticResource H2}" Margin="8,0,28,4" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PodDesc" DockPanel.Dock="Top" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="8,0,28,12"/>
            <TextBlock x:Name="EpCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="EPISODES"/>
            <ListBox x:Name="EpisodeList" MouseDoubleClick="Episode_DoubleClick" MouseRightButtonUp="Episode_RightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="34" Opacity="{Binding TitleOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="No podcasts yet. Choose “add” and paste a podcast's RSS feed address." Visibility="Collapsed"/>
    </Grid>
</UserControl>
