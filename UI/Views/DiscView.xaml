<UserControl x:Class="Halcyon.UI.DiscView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>
    <!-- The disc view, reached from the disc icon in the lower left as in the Zune software: the CD in the drive
         (to rip) and the burn list (songs dragged to the disc icon, to burn). -->
    <Grid Margin="28,8,28,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DriveStatus" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock Text="DRIVE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DriveBox" Width="90" SelectionChanged="Drive_Changed"/>
                <Button Style="{StaticResource TextBtn}" Content="&#xE72C;  read disc" Click="ReadDisc_Click" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PivotBurn" Style="{StaticResource NavTab}" Content="burn list" Tag="burn" GroupName="discPivot" Click="Pivot_Click"/>
                <RadioButton x:Name="PivotCd" Style="{StaticResource NavTab}" Content="cd" Tag="cd" GroupName="discPivot" Click="Pivot_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== the CD in the drive ===== -->
        <DockPanel x:Name="CdPane" Grid.Row="1" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="64"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ARTIST" Style="{StaticResource Label}"/><TextBox x:Name="ArtistBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="ALBUM" Style="{StaticResource Label}"/><TextBox x:Name="AlbumBox"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="YEAR" Style="{StaticResource Label}"/><TextBox x:Name="YearBox"/></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="GENRE" Style="{StaticResource Label}"/><TextBox x:Name="GenreBox"/></StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="LookupBtn" Style="{StaticResource TextBtn}" Content="&#xE721;  look up track names on Discogs" Click="Lookup_Click"/>
            </StackPanel>
            <Grid>
                <ListBox x:Name="RipList" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="2"/>
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CdEmpty" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                           Text="Put an audio CD into your disc drive. Its song list appears here; clear the check box next to any song you don't want, then click START RIP."/>
            </Grid>
        </DockPanel>
        <StackPanel x:Name="CdBar" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RipBtn" Style="{StaticResource PillBtn}" Content="START RIP" Click="Rip_Click"/>
                <TextBlock x:Name="RipFormatText" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Style="{StaticResource TextBtn}" Content="change" Click="RipSettings_Click" Margin="10,0,0,0" ToolTip="Audio format and quality are under Settings, Software, Rip"/>
            </StackPanel>
            <TextBlock x:Name="RipStatus" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="34"/>
        </StackPanel>

        <!-- ===== the burn list ===== -->
        <DockPanel x:Name="BurnPane" Grid.Row="1">
            <TextBlock x:Name="BurnCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Margin="0,0,0,6" Text="BURN LIST"/>
            <Grid>
                <ListBox x:Name="BurnList" BorderThickness="1" BorderBrush="{DynamicResource Line}" SelectionMode="Extended" ItemTemplate="{StaticResource SongRow}"/>
                <TextBlock x:Name="BurnEmpty" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                           Text="The burn list is empty. To add songs, go to your music collection and drag songs or albums to the disc icon."/>
            </Grid>
        </DockPanel>
        <StackPanel x:Name="BurnBar" Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="BurnKindBox" Width="130" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="BurnKind_Changed"
                          ToolTip="Audio CD: plays in any CD player, up to 80 minutes. MP3 CD: hours of music for MP3 CD players and car stereos. Data disc: the files as they are, on a CD, DVD or Blu-ray"/>
                <Button x:Name="BurnBtn" Style="{StaticResource PillBtn}" Content="START BURN" Click="Burn_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="MOVE UP" Click="BurnUp_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="MOVE DOWN" Click="BurnDown_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="REMOVE" Click="BurnRemove_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="CLEAR" Click="BurnClear_Click"/>
            </StackPanel>
            <TextBlock x:Name="BurnStatus" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="34"/>
        </StackPanel>
    </Grid>
</UserControl>
