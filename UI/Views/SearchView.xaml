<UserControl x:Class="Halcyon.UI.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Halcyon.UI">
    <Grid Margin="20,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource H2}" Margin="8,0,0,6"/>
        <WrapPanel x:Name="TagChips" Grid.Row="1" Margin="8,0,0,8" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock x:Name="AlbumCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="ALBUMS"/>
                <ui:TileGrid x:Name="AlbumGrid" TileWidth="150" TileTemplate="{StaticResource AlbumTile}"/>
            </DockPanel>
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition x:Name="OtherRow" Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="SongCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="SONGS"/>
                    <ui:SongHeader x:Name="SongHdr" DockPanel.Dock="Top"/>
                    <ListBox x:Name="SongList" SelectionMode="Extended" ItemTemplate="{StaticResource SongRow}" MouseDoubleClick="Song_DoubleClick" MouseRightButtonUp="Song_RightClick"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="OtherCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="VIDEOS &amp; BOOKS"/>
                    <ListBox x:Name="OtherList" MouseDoubleClick="Other_DoubleClick" MouseRightButtonUp="Other_RightClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="30" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Width="26"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
