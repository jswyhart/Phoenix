<UserControl x:Class="Halcyon.UI.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Halcyon.UI">
    <Grid Margin="20,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="TopBar" Orientation="Horizontal" Margin="8,0,0,12">
            <RadioButton Style="{StaticResource NavTab}" Content="artists" Tag="artists" GroupName="musicTabs" IsChecked="True" Click="Tab_Click"/>
            <RadioButton Style="{StaticResource NavTab}" Content="genres" Tag="genres" GroupName="musicTabs" Click="Tab_Click"/>
            <RadioButton Style="{StaticResource NavTab}" Content="albums" Tag="albums" GroupName="musicTabs" Click="Tab_Click"/>
            <RadioButton Style="{StaticResource NavTab}" Content="songs" Tag="songs" GroupName="musicTabs" Click="Tab_Click"/>
            <Button x:Name="ShuffleAllBtn" Style="{StaticResource NavTabButton}" Content="shuffle all" Click="ShuffleAll_Click" ToolTip="Play the songs on show in a random order"/>
            <TextBlock x:Name="CountText" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Margin="6,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="230"/>
                <ColumnDefinition x:Name="ColMid" Width="1.25*"/>
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="LeftPane">
                <TextBlock x:Name="LeftCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="ARTISTS"/>
                <ListBox x:Name="LeftList" SelectionChanged="Left_SelectionChanged" MouseDoubleClick="Left_DoubleClick" MouseRightButtonUp="Left_RightClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Height="30" Padding="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel x:Name="MidPane" Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="MidCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="ALBUMS"/>
                <ui:TileGrid x:Name="AlbumGrid" TileWidth="150" TileTemplate="{StaticResource AlbumTile}"/>
            </DockPanel>
            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock x:Name="RightCap" DockPanel.Dock="Top" Style="{StaticResource Cap}" Text="SONGS"/>
                <ui:SongHeader x:Name="Header" DockPanel.Dock="Top" Visibility="Collapsed"/>
                <ListBox x:Name="SongList" SelectionMode="Extended" MouseDoubleClick="Song_DoubleClick" MouseRightButtonUp="Song_RightClick"/>
            </DockPanel>

            <StackPanel x:Name="EmptyPanel" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="your collection is empty" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                <TextBlock Foreground="{DynamicResource FgDim}" TextAlignment="Center" Margin="0,0,0,14"
                           Text="Add music folders, or connect a Jellyfin or Plex server, in settings."/>
                <Button Style="{StaticResource PillBtn}" Content="open settings" HorizontalAlignment="Center" Click="OpenSettings_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
