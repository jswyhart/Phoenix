<Window x:Class="Halcyon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Halcyon.UI"
        Title="Phoenix" Width="1320" Height="820" MinWidth="1080" MinHeight="620"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== header: small top navigation, big collection sections ===== -->
        <Grid x:Name="HeaderArea" Grid.Row="0" Margin="28,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackBtn" Style="{StaticResource IconBtn}" Content="&#xE72B;" Margin="-10,0,10,0" ToolTip="Back"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Back_Click" IsEnabled="False"/>
                <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <RadioButton x:Name="NavQuick" Style="{StaticResource NavTop}" Content="QUICKPLAY" GroupName="big" Click="NavBig_Click" Tag="quickplay"/>
                    <RadioButton x:Name="NavColl" Style="{StaticResource NavTop}" Content="COLLECTION" GroupName="big" Click="NavBig_Click" Tag="collection"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTop}" Content="SETTINGS" GroupName="big" Click="NavBig_Click" Tag="settings"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource FgFaint}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,262,0" Width="200" Height="26"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" WindowChrome.IsHitTestVisibleInChrome="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" ToolTip="Search your collection"/>
                </DockPanel>
            </Border>

            <StackPanel x:Name="SubNav" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton Style="{StaticResource NavSection}" Content="music" GroupName="sub" Click="NavSub_Click" Tag="music"/>
                <RadioButton Style="{StaticResource NavSection}" Content="videos" GroupName="sub" Click="NavSub_Click" Tag="videos"/>
                <RadioButton Style="{StaticResource NavSection}" Content="pictures" GroupName="sub" Click="NavSub_Click" Tag="pictures"/>
                <RadioButton Style="{StaticResource NavSection}" Content="podcasts" GroupName="sub" Click="NavSub_Click" Tag="podcasts"/>
                <RadioButton Style="{StaticResource NavSection}" Content="books" GroupName="sub" Click="NavSub_Click" Tag="books"/>
                <RadioButton Style="{StaticResource NavSection}" Content="playlists" GroupName="sub" Click="NavSub_Click" Tag="playlists"/>
                <RadioButton Style="{StaticResource NavSection}" Content="radio" GroupName="sub" Click="NavSub_Click" Tag="radio"/>
            </StackPanel>
        </Grid>
        <!-- the pink tab at the window edge marks the top navigation -->
        <Rectangle Grid.Row="0" Width="7" Height="34" Fill="{StaticResource AccentGrad}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False"/>

        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False"/>

        <!-- ===== now playing layer (always dark) ===== -->
        <Grid x:Name="NowLayer" Grid.Row="0" Grid.RowSpan="2" Background="#0A0A0A" Visibility="Collapsed" TextElement.Foreground="White"
              MouseLeftButtonDown="NowLayer_MouseDown">
            <Grid.Resources>
                <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="FgDim" Color="#B8B8B8"/>
                <SolidColorBrush x:Key="FgFaint" Color="#7A7A7A"/>
                <SolidColorBrush x:Key="BgAlt" Color="#1C1C1C"/>
                <SolidColorBrush x:Key="Line" Color="#333333"/>
                <SolidColorBrush x:Key="Hover" Color="#1EFFFFFF"/>
                <SolidColorBrush x:Key="Selected" Color="#30FFFFFF"/>
            </Grid.Resources>
            <UniformGrid x:Name="Mosaic" Columns="8" Opacity="0.30" ClipToBounds="True"/>
            <Rectangle x:Name="MosaicShade">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#F2000000" Offset="0"/>
                        <GradientStop Color="#59000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <ui:Backdrop x:Name="Backdrop" Visibility="Collapsed"/>

            <ui:Visualizer x:Name="Viz" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.9" Margin="0,48,0,0"/>

            <Grid x:Name="NowInfo" Margin="48,64,28,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                    <Border Width="240" Height="240" HorizontalAlignment="Left" Background="#1C1C1C" Margin="0,0,0,22">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="60" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="NowArt" ui:Art.Size="500" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NowTitle" FontSize="50" FontFamily="Segoe UI Light" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowArtist" FontSize="26" FontFamily="Segoe UI Light" Foreground="#D0D0D0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowAlbum" FontSize="16" Foreground="#909090" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
                <DockPanel x:Name="QueuePane" Grid.Column="1">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button x:Name="QueueTab" Style="{StaticResource BareBtn}" Click="QueueTab_Click" ToolTip="What is playing next">
                            <TextBlock x:Name="QueueTabText" Text="now playing" Style="{StaticResource H2}"/>
                        </Button>
                        <Button x:Name="LyricsTab" Style="{StaticResource BareBtn}" Click="LyricsTab_Click" Margin="20,0,0,0" ToolTip="Lyrics for this song">
                            <TextBlock x:Name="LyricsTabText" Text="lyrics" Style="{StaticResource H2}" Opacity="0.4"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DjText" DockPanel.Dock="Top" FontSize="12" Foreground="#FF6FA5" Margin="8,0,0,6" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    <DockPanel x:Name="LyricsPane" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4,0,0">
                            <Button x:Name="LyricsFindBtn" Style="{StaticResource TextBtn}" Content="find online" Click="LyricsFind_Click" Margin="0,0,14,0" ToolTip="Look this song up on LRCLIB (sends its title, artist and album)"/>
                            <Button x:Name="LyricsImportBtn" Style="{StaticResource TextBtn}" Content="import file" Click="LyricsImport_Click" Margin="0,0,14,0" ToolTip="Use a .lrc or .txt file"/>
                            <Button x:Name="LyricsPasteBtn" Style="{StaticResource TextBtn}" Content="paste" Click="LyricsPaste_Click" Margin="0,0,14,0" ToolTip="Use the lyrics on the clipboard"/>
                            <Button x:Name="LyricsRemoveBtn" Style="{StaticResource TextBtn}" Content="remove" Click="LyricsRemove_Click" ToolTip="Remove the lyrics you imported for this song"/>
                        </StackPanel>
                        <TextBlock x:Name="LyricsNote" DockPanel.Dock="Bottom" FontSize="11" Foreground="{DynamicResource FgFaint}" Margin="8,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <ListBox x:Name="LyricsList" MouseDoubleClick="Lyrics_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" Opacity="{Binding Opacity}" Margin="0,5,8,5" MinHeight="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="LyricsEmpty" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Margin="8,8,16,0" VerticalAlignment="Top"/>
                        </Grid>
                    </DockPanel>
                    <ListBox x:Name="QueueList" MouseDoubleClick="Queue_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="44" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="T" ui:Tr.Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource FgFaint}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="#FF6FA5"/>
                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Hidden" Stretch="Uniform"/>

            <Button x:Name="BackNowBtn" Style="{StaticResource IconBtn}" Content="&#xE72B;" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,2,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseNow_Click" ToolTip="Back to collection (Esc)"/>
            <Button x:Name="VizBtn" Style="{StaticResource IconBtn}" Content="&#xE9D9;" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,2,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Viz_Click" ToolTip="Visualizer style and colours (V and C cycle them)"/>
            <Button x:Name="FullBtn" Style="{StaticResource IconBtn}" Content="&#xE740;" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="98,2,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Full_Click" ToolTip="Full screen (F11, or double-click)"/>
        </Grid>

        <!-- caption buttons sit above everything -->
        <StackPanel x:Name="Caption" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MiniBtn" Style="{StaticResource IconBtn}" Content="&#xE73F;" Width="44" FontSize="11" Click="Mini_Click" ToolTip="Mini player"/>
            <Button x:Name="MinBtn" Style="{StaticResource IconBtn}" Content="&#xE921;" Width="44" FontSize="10" Click="Min_Click"/>
            <Button x:Name="MaxBtn" Style="{StaticResource IconBtn}" Content="&#xE922;" Width="44" FontSize="10" Click="Max_Click"/>
            <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Content="&#xE8BB;" Width="44" FontSize="10" Click="Close_Click"/>
            <Button x:Name="LogoBtn" Style="{StaticResource BareBtn}" Width="40" Height="40" Margin="6,0,0,0" Click="Logo_Click" ToolTip="Quickplay" Foreground="White">
                <Border Width="40" Height="40" Background="#271715">
