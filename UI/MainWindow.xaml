                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E12373" Offset="0"/>
                                <GradientStop Color="#E42D6B" Offset="0.25"/>
                                <GradientStop Color="#E84658" Offset="0.5"/>
                                <GradientStop Color="#ED6235" Offset="0.75"/>
                                <GradientStop Color="#EF7A24" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Border>
            </Button>
        </StackPanel>

        <!-- ===== transport ===== -->
        <Border x:Name="Transport" Grid.Row="2" Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid Height="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- left: drag music onto these to sync it with the phone, add it to the burn list, or add it to a playlist -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button x:Name="PhoneTarget" Style="{StaticResource DropBtn}" Tag="phone" Click="DropTarget_Click" AllowDrop="True" DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            ToolTip="Phone. Drag and drop things here to sync with your phone.">
                        <Grid Width="18" Height="28">
                            <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="2" CornerRadius="3"/>
                            <Rectangle Fill="{StaticResource AccentGrad}" Margin="4,5,4,8"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DiscTarget" Style="{StaticResource DropBtn}" Tag="disc" Click="DropTarget_Click" AllowDrop="True" DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            ToolTip="Disc. Drag songs or albums here to add them to the burn list; click to rip or burn a CD.">
                        <Grid Width="28" Height="28">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
                            <Ellipse Width="8" Height="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PlaylistTarget" Style="{StaticResource DropBtn}" Tag="playlist" Click="DropTarget_Click" AllowDrop="True" DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            ToolTip="Click to see playlists. Drag items to create or add to playlists.">
                        <Grid Width="22" Height="28">
                            <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="2" CornerRadius="2"/>
                            <StackPanel VerticalAlignment="Center" Margin="5,0">
                                <Rectangle Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,2"/>
                                <Rectangle Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,2"/>
                                <Rectangle Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,2"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="DropHint" Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="170" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- centre: what is playing, with its progress underneath -->
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Left" Style="{StaticResource BareBtn}" Click="OpenNow_Click" ToolTip="Now playing" Margin="0,0,14,0">
                        <Grid Width="56" Height="56" Background="{DynamicResource Line}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="BarArt" ui:Art.Size="120" Stretch="UniformToFill"/>
                        </Grid>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BookmarkBtn" Style="{StaticResource IconBtn}" Width="30" Height="30" Content="&#xE734;" Click="Bookmark_Click" ToolTip="Bookmark this spot in the audiobook" Visibility="Collapsed"/>
                                <Button x:Name="HeartBtn" Style="{StaticResource IconBtn}" Width="30" Height="30" Content="&#xEB51;" Click="Heart_Click" ToolTip="Like / dislike this song"/>
                            </StackPanel>
                            <Button Style="{StaticResource BareBtn}" Click="OpenNow_Click" ToolTip="Now playing" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock x:Name="BarTitle" FontSize="15" TextTrimming="CharacterEllipsis" Text="nothing playing"/>
                                    <TextBlock x:Name="BarArtist" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="BarInfo" Foreground="{DynamicResource FgFaint}" FontSize="10.5" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="PosText" DockPanel.Dock="Left" Width="40" TextAlignment="Left" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DurText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                            <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged"
                                    Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>

                <!-- right: transport -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Button x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" Content="&#xE8B1;" FontSize="14" Click="Shuffle_Click" ToolTip="Shuffle"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="22" Width="48" Click="Play_Click" ToolTip="Play / pause (Space)"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click" ToolTip="Next"/>
                    <Button x:Name="RepeatBtn" Style="{StaticResource IconBtn}" Content="&#xE8EE;" FontSize="14" Click="Repeat_Click" ToolTip="Repeat"/>
                    <Button x:Name="MoreBtn" Style="{StaticResource IconBtn}" Content="&#xE712;" FontSize="15" Click="More_Click" ToolTip="Sleep timer, playback speed, play on another device"/>
                    <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute" Margin="2,0,0,0"/>
                    <Slider x:Name="Volume" Width="84" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="Volume_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
