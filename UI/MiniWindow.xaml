<Window x:Class="Halcyon.UI.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Halcyon.UI"
        Title="Phoenix" Width="380" Height="96" WindowStyle="None" ResizeMode="NoResize" Topmost="True" AllowsTransparency="False"
        Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}" FontFamily="{DynamicResource TextFont}" FontSize="13"
        MouseLeftButtonDown="Window_MouseDown" ShowInTaskbar="True">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Height="3" Background="{DynamicResource Line}">
                <Rectangle x:Name="Progress" Fill="{DynamicResource AccentGrad}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <Grid DockPanel.Dock="Left" Width="94" Background="{DynamicResource Line}">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="ArtImage" ui:Art.Size="200" Stretch="UniformToFill"/>
            </Grid>
            <Grid Margin="12,6,4,4">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
                    <TextBlock x:Name="TitleText" FontSize="14" TextTrimming="CharacterEllipsis" Text="nothing playing"/>
                    <TextBlock x:Name="ArtistText" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" Content="&#xE740;" FontSize="11" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Restore_Click" ToolTip="Back to full view"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-8,0,0,0">
                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Height="30" Click="Prev_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="18" Height="30" Click="Play_Click"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Height="30" Click="Next_Click"/>
                    <Button x:Name="HeartBtn" Style="{StaticResource IconBtn}" Content="&#xEB51;" FontSize="13" Height="30" Click="Heart_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
