<Project Sdk="Microsoft.NET.Sdk">

  <!-- Halcyon for Android: native Android views over the shared Halcyon.Core logic, ExoPlayer (Media3) for playback. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Halcyon.Droid</RootNamespace>
    <AssemblyName>Halcyon.Droid</AssemblyName>
    <ApplicationId>com.halcyon.player</ApplicationId>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.7</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Halcyon.Core\Halcyon.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.*" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.*" />
  </ItemGroup>

</Project>
