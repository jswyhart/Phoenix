<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, platform-neutral logic of Halcyon (adapted from the Windows app's Core\ and Services\). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Halcyon</RootNamespace>
    <AssemblyName>Halcyon.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

</Project>
