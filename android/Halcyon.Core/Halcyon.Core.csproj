<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, platform-neutral logic of Halcyon (adapted from the Windows app's Core\ and Services\). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Halcyon</RootNamespace>
    <AssemblyName>Halcyon.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- shared with the Windows app as they are -->
    <Compile Include="..\..\Services\AutoEq.cs" Link="AutoEq.cs" />
    <Compile Include="..\..\Services\AutoEqAi.cs" Link="AutoEqAi.cs" />
    <Compile Include="..\..\Services\HeadphoneEq.cs" Link="HeadphoneEq.cs" />
  </ItemGroup>

</Project>
