<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:Halcyon.Desktop">
    <Styles.Resources>
        <ResourceDictionary>
            <d:RatingText x:Key="RatingText"/>
            <d:RatingOpacity x:Key="RatingOpacity"/>
            <d:PlayedOpacity x:Key="PlayedOpacity"/>
            <d:NotEmpty x:Key="NotEmpty"/>
            <d:GroupRowHeight x:Key="GroupRowHeight"/>
            <d:TrackNo x:Key="TrackNo"/>
            <!-- line icons in a 16 x 16 box, in the spirit of the Windows app's Segoe MDL2 glyphs -->
            <StreamGeometry x:Key="IconBack">M10,3 L5,8 L10,13 M5,8 L14,8</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M2,6.5 A4.5,4.5 0 1 0 11,6.5 A4.5,4.5 0 1 0 2,6.5 M9.8,9.8 L14,14</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M4.5,2 L13,8 L4.5,14 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M3.5,2 L6.5,2 L6.5,14 L3.5,14 Z M9.5,2 L12.5,2 L12.5,14 L9.5,14 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPrev">M3,2 L3,14 M13,2.5 L5,8 L13,13.5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconNext">M13,2 L13,14 M3,2.5 L11,8 L3,13.5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconShuffle">M1,4.5 L4,4.5 C8,4.5 8,11.5 12,11.5 L15,11.5 M13,9.5 L15,11.5 L13,13.5 M1,11.5 L4,11.5 C8,11.5 8,4.5 12,4.5 L15,4.5 M13,2.5 L15,4.5 L13,6.5</StreamGeometry>
            <StreamGeometry x:Key="IconRepeat">M2.5,9.5 L2.5,5 L13,5 M11,3 L13,5 L11,7 M13.5,6.5 L13.5,11 L3,11 M5,9 L3,11 L5,13</StreamGeometry>
            <StreamGeometry x:Key="IconRepeatOne">M2.5,9.5 L2.5,5 L13,5 M11,3 L13,5 L11,7 M13.5,6.5 L13.5,11 L3,11 M5,9 L3,11 L5,13 M7.5,7 L8.5,6.4 L8.5,9.6</StreamGeometry>
            <StreamGeometry x:Key="IconHeart">M8,14 C3,10.2 1,8 1,5.5 C1,3 3,1.5 5,1.5 C6.5,1.5 7.5,2.5 8,3.6 C8.5,2.5 9.5,1.5 11,1.5 C13,1.5 15,3 15,5.5 C15,8 13,10.2 8,14 Z</StreamGeometry>
            <StreamGeometry x:Key="IconVolume">M1.5,6 L4.5,6 L8.5,2.5 L8.5,13.5 L4.5,10 L1.5,10 Z M11,5.5 C12.3,6.8 12.3,9.2 11,10.5 M13,3.5 C15.3,5.8 15.3,10.2 13,12.5</StreamGeometry>
            <StreamGeometry x:Key="IconMute">M1.5,6 L4.5,6 L8.5,2.5 L8.5,13.5 L4.5,10 L1.5,10 Z M11,6 L15,10 M15,6 L11,10</StreamGeometry>
            <StreamGeometry x:Key="IconVisualizer">M2,14 L2,9 M5,14 L5,4 M8,14 L8,7 M11,14 L11,2 M14,14 L14,10</StreamGeometry>
            <StreamGeometry x:Key="IconFull">M2,6 L2,2 L6,2 M10,2 L14,2 L14,6 M14,10 L14,14 L10,14 M6,14 L2,14 L2,10</StreamGeometry>
            <StreamGeometry x:Key="IconBookmark">M8,1.5 L10,6 L15,6.3 L11.2,9.5 L12.4,14.5 L8,11.8 L3.6,14.5 L4.8,9.5 L1,6.3 L6,6 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlaylist">M3,1.5 L13,1.5 L13,14.5 L3,14.5 Z M5.5,5 L10.5,5 M5.5,8 L10.5,8 M5.5,11 L10.5,11</StreamGeometry>
            <StreamGeometry x:Key="IconNote">M6,12 A2,2 0 1 1 6,11.99 M8,12 L8,2.5 L13,1.5 L13,4 L8,5</StreamGeometry>

            <LinearGradientBrush x:Key="AccentGrad" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#F0603A" Offset="0"/>
                <GradientStop Color="#D5358F" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== rows ===== -->
            <DataTemplate x:Key="SongRow">
                <Grid Height="30" ColumnDefinitions="34,3*,2*,2*,1.5*,56,30" Background="Transparent">
                    <TextBlock Text="{Binding $parent[ListBoxItem].(d:Row.Number)}" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding TagText}" Foreground="{DynamicResource Accent}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Button Grid.Column="6" Classes="heart" Content="{Binding Rating, Converter={StaticResource RatingText}}" Opacity="{Binding Rating, Converter={StaticResource RatingOpacity}}"
                            Command="{x:Static d:Cmd.Rate}" CommandParameter="{Binding}" ToolTip.Tip="Like / dislike"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SongRowCompact">
                <Grid Height="30" ColumnDefinitions="34,*,56,30" Background="Transparent">
                    <TextBlock Text="{Binding $parent[ListBoxItem].(d:Row.Number)}" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Classes="heart" Content="{Binding Rating, Converter={StaticResource RatingText}}" Opacity="{Binding Rating, Converter={StaticResource RatingOpacity}}"
                            Command="{x:Static d:Cmd.Rate}" CommandParameter="{Binding}" ToolTip.Tip="Like / dislike"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="NameRow">
                <TextBlock Text="{Binding}" FontSize="14" Height="30" Padding="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
            <DataTemplate x:Key="PathRow">
                <d:PathText Path="{Binding}" TextElement.FontSize="14" Height="30" ToolTip.Tip="{Binding}"/>
            </DataTemplate>
            <DataTemplate x:Key="NamedRow">
                <TextBlock Text="{Binding Name}" FontSize="14" Height="30" Padding="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
            <DataTemplate x:Key="CountRow">
                <DockPanel Height="30">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="GroupRow">
                <DockPanel Height="{Binding Art, Converter={StaticResource GroupRowHeight}}">
                    <Border DockPanel.Dock="Left" Width="40" Height="60" Background="{DynamicResource BgAlt}" Margin="0,0,12,0" ClipToBounds="True"
                            IsVisible="{Binding Art, Converter={StaticResource NotEmpty}}">
                        <Image d:Art.Size="120" d:Art.Path="{Binding Art}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="VideoRow">
                <DockPanel Height="64">
                    <Border DockPanel.Dock="Left" Width="96" Height="54" Background="{DynamicResource BgAlt}" Margin="0,0,14,0" ClipToBounds="True">
                        <Image d:Art.Size="200" d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="12,0,18,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding RowTitle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding EpisodeCode}" Foreground="{DynamicResource FgFaint}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="PodcastRow">
                <DockPanel Height="64">
                    <Border DockPanel.Dock="Left" Width="52" Height="52" Background="{DynamicResource BgAlt}" Margin="0,0,12,0" ClipToBounds="True">
                        <Image d:Art.Size="120" d:Art.Path="{Binding ArtUrl}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="EpisodeRow">
                <Grid Height="34" ColumnDefinitions="*,110,70" Opacity="{Binding Played, Converter={StaticResource PlayedOpacity}}">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}"/>
                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="QueueRow">
                <DockPanel Height="44" Background="Transparent">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes.current="{Binding IsCurrent}" Classes="queueTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource FgFaint}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="DiscogsRow">
                <DockPanel Height="60">
                    <Border DockPanel.Dock="Left" Width="48" Height="48" Background="{DynamicResource BgAlt}" Margin="0,0,12,0" ClipToBounds="True">
                        <Image d:Art.Size="100" d:Art.Path="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="CompareRow">
                <Grid Height="26" ColumnDefinitions="28,*,*">
                    <TextBlock Text="{Binding No}" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Mine}" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Theirs}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <!-- ===== tiles (Title / Caption / ArtPath) ===== -->
            <DataTemplate x:Key="SquareTile">
                <StackPanel>
                    <Border Width="138" Height="138" Background="{DynamicResource BgAlt}" HorizontalAlignment="Left" ClipToBounds="True">
                        <Image d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SmallTile">
                <StackPanel>
                    <Border Width="112" Height="112" Background="{DynamicResource BgAlt}" HorizontalAlignment="Left" ClipToBounds="True">
                        <Image d:Art.Size="240" d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" FontSize="12"/>
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource FgDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="PosterTile">
                <StackPanel>
                    <Border Width="150" Height="225" Background="{DynamicResource BgAlt}" HorizontalAlignment="Left" ClipToBounds="True">
                        <Image d:Art.Size="320" d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="WideTile">
                <StackPanel>
                    <Border Width="208" Height="117" Background="{DynamicResource BgAlt}" HorizontalAlignment="Left" ClipToBounds="True">
                        <Image d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="PictureTile">
                <Border Width="148" Height="148" Background="{DynamicResource BgAlt}" ClipToBounds="True" ToolTip.Tip="{Binding Title}">
                    <Image d:Art.Size="300" d:Art.Path="{Binding ArtPath}" Stretch="UniformToFill"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== text ===== -->
    <Style Selector="TextBlock.cap">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FgFaint}"/>
        <Setter Property="Margin" Value="8,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        <Setter Property="Margin" Value="0,8,0,3"/>
    </Style>
    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <!-- oversized faded word above a Quickplay row -->
    <Style Selector="TextBlock.zunehead">
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{DynamicResource FgFaint}"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Margin" Value="4,-4,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="TextBlock.queueTitle.current">
        <Setter Property="Foreground" Value="#FF6FA5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== navigation: plain words, the chosen one darkest ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{DynamicResource FgFaint}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover"><Setter Property="Foreground" Value="{DynamicResource FgDim}"/></Style>
    <Style Selector="RadioButton.nav:checked"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <!-- QUICKPLAY  COLLECTION  SETTINGS along the top -->
    <Style Selector="RadioButton.nav.top">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,22,0"/>
    </Style>
    <!-- music  videos  pictures … under it -->
    <Style Selector="RadioButton.nav.section">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Margin" Value="0,0,22,0"/>
    </Style>
    <Style Selector="RadioButton.nav.small">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>
    <Style Selector="RadioButton.nav.tab">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
    <Style Selector="RadioButton.nav.pivot">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>

    <!-- ===== buttons ===== -->
    <Style Selector="Button.text">
        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.text:pointerover"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="Button.text:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="Button.text.on"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="Button.text.sorted"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="Button.text.big">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- icon buttons: a line icon drawn in the button's colour, dim until pointed at (the Windows IconBtn) -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.icon:disabled"><Setter Property="Opacity" Value="0.25"/></Style>
    <Style Selector="Button.icon.on"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="Button.icon Path">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="Button.icon.big Path"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/></Style>
    <Style Selector="Button.icon.filled Path"><Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/></Style>

    <!-- the playlist icon in the lower left: click to open playlists -->
    <Style Selector="Button.drop">
        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.drop:pointerover"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="Button.drop Path">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Stretch" Value="Fill"/>
    </Style>

    <Style Selector="Button.heart">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.bare">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.bare:pointerover /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource Hover}"/></Style>
    <!-- grey box with a hairline border: the Windows PillBtn -->
    <Style Selector="Button.pill">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.pill:pointerover /template/ Border#Bd"><Setter Property="BorderBrush" Value="{DynamicResource FgFaint}"/></Style>
    <Style Selector="Button.pill:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

    <!-- ===== lists: grey hover and selection, as on Windows ===== -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.boxed">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>
    <Style Selector="ListBox:not(.plain) ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>
    <Style Selector="ListBox:not(.plain) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Selected}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>
    <Style Selector="ListBox:not(.plain) ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Selected}"/>
    </Style>
    <Style Selector="ListBox:not(.plain) ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Selected}"/>
    </Style>
    <!-- rows of tiles: no hover, focus or selection look of their own (the presenter is deliberately not named
         PART_ContentPresenter, so the toolkit's list styles can't find it) -->
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
            <ControlTemplate><ContentPresenter Name="RowPresenter" Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.tile:pointerover"><Setter Property="Background" Value="{DynamicResource Hover}"/></Style>
    <Style Selector="Border.tile.sel"><Setter Property="Background" Value="{DynamicResource Selected}"/></Style>

    <!-- ===== text boxes: grey fill and hairline border, square ===== -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FgFaint}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:pointerover"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="TextBox:focus"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <!-- the search box in the header: just an underline -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="2,4,22,4"/>
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="RadioButton:not(.nav)"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="Slider"><Setter Property="Focusable" Value="False"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="0"/></Style>
</Styles>
